			)
			(justify left top)
		)
		(uuid "1696f510-d4fe-420d-a69f-d4b1d35972a2")
	)
	(text_box "ENC2_Z level translation: 5.1 k series and 10 k to GND. 5 V input produces approximately 3.31 V at the RP2350 pin."
