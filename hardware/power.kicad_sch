			)
			(justify left top)
		)
		(uuid "01108f99-7aaf-4009-8772-0a775b568189")
	)
	(text_box "U3 is a 24 V to 12 V LMR36510 buck powered from the isolated PLC field supply on J33/J45. D3 provides reverse protection and the complete converter loop references PLC_0V."
