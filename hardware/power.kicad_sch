			)
			(justify left top)
		)
		(uuid "99687966-abac-4ad8-950b-d10f4b6805da")
	)
	(text_box "J2 carries the isolated 12 V backlight rail generated from the PLC 24 V field supply and its PLC_0V return. Backlight PWM is not provided by this board."
		(exclude_from_sim no)
		(at 15 240 0.0000)
		(size 180 30)
		(margins 0.9525 0.9525 0.9525 0.9525)
