	(no_connect
		(at 260.35 314.96)
		(uuid "c3e75a66-ef23-4dd5-8aeb-dcc9c0448682")
	)
	(text_box "Power tree: fused 12-24 V input with a TVS and two independent 1 A series-diode feeds. One feed powers the 5 V logic buck and analog housekeeping; the other powers a dedicated 12 V backlight buck. WeAct onboard 3.3 V regulation supplies only the module, and the ESP has its own 3.3 V LDO."
		(exclude_from_sim no)
		(at 15 15 0.0000)
		(size 175 28)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0.127)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a861d1cf-4692-4594-a408-38db2ad36c10")
	)
	(text_box "Default: the LMR36510 generates +5V for the module and both peripheral LDOs. The WeAct onboard regulator supplies only the module, whose 3V3 outputs and VBUS remain local."
		(exclude_from_sim no)
		(at 120 165 0.0000)
		(size 140 34)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0.127)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6b0d0d0d-c0fe-4707-b205-1a43e441d6f1")
	)
	(text_box "J2 carries the dedicated +12 V backlight/CCFL supply, a 3.3 V PWM control signal from GPIO1, and ground. GPIO1 also drives the optional Q8 low-side return through a 100 ohm gate resistor. High-current switching remains on the external inverter or backlight driver."
		(exclude_from_sim no)
		(at 15 240 0.0000)
		(size 180 30)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0.127)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b0e1120c-3a35-481b-b906-8511e23fdbe6")
	)
	(text_box "U3 is a second LMR36510 buck set to 12 V for the LCD backlight/CCFL inverter supply. It uses 47 uH, 100 k / 9.09 k feedback, 3x22 uF/25 V output and 22 uF/50 V + 100 nF/100 V local input. The existing U37 +12V_AO supply remains separate."
		(exclude_from_sim no)
		(at 250 250 0.0000)
		(size 210 42)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0.127)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
