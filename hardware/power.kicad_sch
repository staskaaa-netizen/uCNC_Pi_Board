			(justify left top)
		)
		(uuid "a057b640-ea25-4216-b5bd-1a0e02c9a0e7")
	)
	(text_box "J2 carries the isolated 12 V backlight rail generated from the PLC 24 V field supply and its ISO_GND return. Backlight PWM is not provided by this board."
		(exclude_from_sim no)
		(at 15 240 0.0000)
